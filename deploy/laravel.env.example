# ───────────────────────────────────────────────────────────────────────────
# Convine — Laravel PRODUCTION env template.
# Copy to backend/.env on the droplet, fill the blanks, then `php artisan key:generate`.
# Never commit the real .env (it is gitignored).
# ───────────────────────────────────────────────────────────────────────────

APP_NAME=Convine
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOURDOMAIN.me
APP_FRONTEND_URL=https://YOURDOMAIN.me

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database: SQLite (one file on the droplet, persists across redeploys) ──
DB_CONNECTION=sqlite
# Laravel uses backend/database/database.sqlite by default — create it with:
#   touch database/database.sqlite

# ── Sessions / cookies (same-origin SPA over HTTPS) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=YOURDOMAIN.me,www.YOURDOMAIN.me

# ── Logging ──
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail (optional; only if you later send RSVP emails) ──
MAIL_MAILER=log
MAIL_FROM_NAME="${APP_NAME}"
